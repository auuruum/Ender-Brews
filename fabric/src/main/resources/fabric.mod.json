{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "${homepage}",
        "sources": "${sources}"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "dev.enderbrews.fabric.EnderBrewsFabric"
        ],
        "client": [
            "dev.enderbrews.fabric.EnderBrewsFabricClient"
        ]
    },
    "accessWidener": "enderbrews.accesswidener",
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-lifecycle-events-v1": "*",
        "fabric-networking-api-v1": "*",
        "fabric-command-api-v2": "*",
        "fabric-message-api-v1": "*",
        "fabric-item-api-v1": "*",
        "fabric-screen-api-v1": "*",
        "fabric-key-binding-api-v1": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
